# ============================================================
# Bybit ICT Trading Bot — Environment Variables
# Copy this file to .env and fill in your values.
# On Railway, set these via the Variables tab (never commit .env).
# ============================================================

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Railway provisions this automatically when you add a PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Bybit API credentials ─────────────────────────────────────────────────────
# Create API keys at https://bybit.com → Account → API Management
# Required permissions: Read + Trade (Derivatives / Unified Trading Account)
#
# Testnet keys: https://testnet.bybit.com → Account → API Management
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Set to "true" for Bybit Testnet, "false" for live trading
BYBIT_TESTNET=true

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# Set to "true" to start the bot automatically on server boot.
# Requires BYBIT_API_KEY and BYBIT_API_SECRET to be set.
# When false (default), start the bot via POST /api/bot/start
AUTO_START_BOT=false
